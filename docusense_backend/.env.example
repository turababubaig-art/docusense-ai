APP_NAME=DocuSense AI
APP_VERSION=6.0.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=4000

# Backward-compatible provider configuration from the existing backend.
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_ENDPOINT=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
MAX_DOCUMENT_PAGES=1000
FILE_RETENTION_HOURS=24
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.png,.jpg,.jpeg,.webp

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CONTEXT_CHARS=24000
MAX_CHAT_CONTEXT_CHARS=24000
SEARCH_INDEX_LIMIT=12000

OCR_ENABLED=true
TESSERACT_PATH=
OCR_WORKERS=4
FAST_PDF_ENGINE=fitz

BATCH_CONCURRENCY=4
MAX_BATCH_FILES=20
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
CACHE_TTL_SECONDS=300
